<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar Auto - <%= nombre %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('../partials/header') %>

    <main>
        <article class="detalle-auto">
            <h2>Editar Auto: <%= auto.marca %> <%= auto.modelo %></h2>
            <form action="/autos/editar/<%= auto.id %>" method="POST" class="formulario">
                <div>
                    <label for="marca">Marca:</label>
                    <input type="text" id="marca" name="marca" value="<%= auto.marca %>" required>
                </div>
                <div>
                    <label for="modelo">Modelo:</label>
                    <input type="text" id="modelo" name="modelo" value="<%= auto.modelo %>" required>
                </div>
                <div>
                    <label for="existencias">Existencias:</label>
                    <input type="number" id="existencias" name="existencias" min="0" value="<%= auto.existencias %>" required>
                </div>
                <div>
                    <label for="categoria_id">Categoría:</label>
                    <select id="categoria_id" name="categoria_id" required>
                        <% categorias.forEach(function(cat) { %>
                            <option value="<%= cat.id %>" <%= auto.categoria_id === cat.id ? 'selected' : '' %>><%= cat.nombre %></option>
                        <% }); %>
                    </select>
                </div>
                <div>
                    <label for="proveedor_id">Proveedor:</label>
                    <select id="proveedor_id" name="proveedor_id" required>
                        <% proveedores.forEach(function(prov) { %>
                            <option value="<%= prov.id %>" <%= auto.proveedor_id === prov.id ? 'selected' : '' %>><%= prov.nombre %></option>
                        <% }); %>
                    </select>
                </div>
                <button type="submit" class="btn">Actualizar Auto</button>
            </form>
            <br>
            <a href="/autos/auto/<%= auto.id %>">Cancelar y volver al detalle</a>
        </article>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>

