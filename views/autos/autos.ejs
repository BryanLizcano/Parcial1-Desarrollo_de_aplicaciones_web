<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Catálogo de Autos - <%= nombre %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('../partials/header', { nombre: nombre }) %>

    <main>
        <!-- Barra de filtros por categoría -->
        <section class="filtros" style="margin: 1.5rem 0; display: flex; gap: 10px; flex-wrap: wrap;">
            <a href="/autos" class="<%= !categoriaActual ? 'activo' : '' %>">Todas</a>
            <% categorias.forEach(function(cat) { %>
                <a href="/autos?categoria=<%= cat.nombre %>" 
                   class="<%= categoriaActual === cat.nombre ? 'activo' : '' %>">
                    <%= cat.nombre %>
                </a>
            <% }); %>
        </section>

        <!-- Listado de Autos -->
        <div style="margin-bottom: 1rem;">
            <a href="/autos/crear" style="display: inline-block; padding: 10px 15px; background-color: #28a745; color: white; text-decoration: none; border-radius: 5px;">Crear Nuevo Auto</a>
        </div>
        <section class="listado">
            <% if (autos.length === 0) { %>
                <p>No se encontraron autos en esta categoría.</p>
            <% } else { %>
                <% autos.forEach(function(auto) { %>
                    <article class="tarjeta-auto">
                        <h2><%= auto.marca %> <%= auto.modelo %></h2>
                        <p>Categoría: <%= auto.categoria %></p>
                        <a href="/autos/auto/<%= auto.id %>">Ver detalle</a>
                    </article>
                <% }); %>
            <% } %>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>