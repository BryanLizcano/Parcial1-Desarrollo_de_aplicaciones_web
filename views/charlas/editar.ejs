<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar Charla - <%= nombre %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('../partials/header') %>

    <main>
        <article class="detalle-auto">
            <h2>Editar Charla: <%= charla.titulo %></h2>
            <form action="/charlas/editar/<%= charla._id %>" method="POST" class="formulario">
                <div>
                    <label for="titulo">Título:</label>
                    <input type="text" id="titulo" name="titulo" value="<%= charla.titulo %>" required>
                </div>
                <div>
                    <label for="descripcion">Descripción:</label>
                    <textarea id="descripcion" name="descripcion" required style="width: 100%; height: 100px; padding: 0.5rem;"><%= charla.descripcion %></textarea>
                </div>
                <div>
                    <label for="fecha">Fecha:</label>
                    <input type="text" id="fecha" name="fecha" value="<%= charla.fecha %>" required>
                </div>
                <div>
                    <label for="hora">Hora:</label>
                    <input type="text" id="hora" name="hora" value="<%= charla.hora %>" required>
                </div>
                <h3 style="margin-top: 15px;">Datos del Expositor</h3>
                <div>
                    <label for="expositor_nombre">Nombre del Expositor:</label>
                    <input type="text" id="expositor_nombre" name="expositor_nombre" value="<%= charla.expositor.nombre %>" required>
                </div>
                <div>
                    <label for="expositor_especialidad">Especialidad:</label>
                    <input type="text" id="expositor_especialidad" name="expositor_especialidad" value="<%= charla.expositor.especialidad %>" required>
                </div>
                <div>
                    <label for="expositor_correo">Correo:</label>
                    <input type="email" id="expositor_correo" name="expositor_correo" value="<%= charla.expositor.correo %>" required>
                </div>
                <button type="submit" class="btn">Actualizar Charla</button>
            </form>
            <br>
            <a href="/charlas">Cancelar y volver</a>
        </article>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>

