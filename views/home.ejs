<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Menú Principal - <%= nombre %></title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .menu-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 50px;
        }
        .opcion-menu {
            padding: 40px;
            border: 2px solid #2c3e50;
            border-radius: 10px;
            text-align: center;
            text-decoration: none;
            color: #2c3e50;
            font-size: 22px;
            font-weight: bold;
            transition: 0.3s;
            background-color: white;
        }
        .opcion-menu:hover {
            background-color: #2c3e50;
            color: white;
        }
    </style>
</head>
<body>
    <%- include('partials/header', { nombre: nombre }) %>

    <main>
        <h2 style="text-align: center; margin-top: 20px;">¿Qué opcion deseas ver?</h2>
        
        <div class="menu-container">
            <a href="/recetas" class="opcion-menu">
                🍽️ Recetas<br>
                <small style="font-size: 14px; font-weight: normal;">(MongoDB Atlas)</small>
            </a>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>